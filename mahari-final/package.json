    "recharts":                  "^2.12.7",
    "zod":                       "^3.23.8"
  },
  "devDependencies": {
    "@types/node":               "^20",
    "@types/react":              "^18",
    "@types/react-dom":          "^18",
    "typescript":                "^5",
    "tailwindcss":               "^3.4.1",
    "postcss":                   "^8",
    "autoprefixer":              "^10",
    "eslint":                    "^8",
    "eslint-config-next":        "14.2.3",
    "supabase":                  "^1.170.0"
