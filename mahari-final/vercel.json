{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["bah1"],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL":      { "value": "@mahari-supabase-url" },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": { "value": "@mahari-supabase-anon-key" },
    "SUPABASE_SERVICE_ROLE_KEY":     { "value": "@mahari-service-role-key" },
    "ANTHROPIC_API_KEY":             { "value": "@mahari-anthropic-key" },
    "NEXT_PUBLIC_APP_URL":           { "value": "@mahari-app-url" }
  },
  "headers": [
    {
      "source":  "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
